<Window x:Class="ArenaMonstruosa.HistoriaWindow"
        Icon="/RaposaIco.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórias dos Personagens"
        Height="780"
        Width="1050"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D11">

    <Grid>

        <Image Source="/Imagens/fundo_medieval.png"
               Stretch="UniformToFill"/>

        <Image Source="/Imagens/ImgTitulo.png"
               Width="430"
               Height="230"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,-20,0,0"/>

        <Button x:Name="btnVoltar"
                Width="170"
                Height="60"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnVoltar_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">

                    <Grid>

                        <Image x:Name="imgVoltar"
                               Source="/Imagens/BotaoVoltar.png"
                               Stretch="Uniform"/>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="imgVoltar"
                                    Property="Opacity"
                                    Value="0.85"/>
                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="imgVoltar"
                                    Property="Opacity"
                                    Value="0.70"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Button.Template>

        </Button>

        <Button x:Name="btnSair"
                Width="170"
                Height="60"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnSair_Click">

            <Button.Template>

                <ControlTemplate TargetType="Button">

                    <Grid>

                        <Image x:Name="imgSair"
                               Source="/Imagens/BotaoSair.png"
                               Stretch="Uniform"/>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="imgSair"
                                    Property="Opacity"
                                    Value="0.85"/>
                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="imgSair"
                                    Property="Opacity"
                                    Value="0.70"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Button.Template>

        </Button>

        <Border x:Name="bordaPersonagem"
                Width="900"
                Height="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,75,0,0"
                Background="#CC16120E"
                BorderThickness="3"
                CornerRadius="18">

            <Grid Margin="25">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="BordaImagem"
                        Width="300"
                        Height="400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="{Binding ElementName=bordaPersonagem, Path=BorderBrush}"
                        BorderThickness="3"
                        CornerRadius="15">

                    <Image x:Name="imgPersonagem"
                           Stretch="UniformToFill"/>

                </Border>

                <StackPanel Grid.Column="1"
                            Margin="30,5">

                    <TextBlock x:Name="txtNome"
                               Text="CAVALEIRO"
                               FontSize="34"
                               FontWeight="Bold"
                               FontFamily="Georgia"
                               HorizontalAlignment="Center"/>

                    <Border x:Name="LinhaTitulo"
                            Height="3"
                            Margin="0,15,0,20"
                            Background="{Binding ElementName=bordaPersonagem, Path=BorderBrush}"/>

                    <ScrollViewer Height="270"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  BorderThickness="0">

                        <TextBlock x:Name="txtHistoria"
                                   FontSize="18"
                                   FontFamily="Georgia"
                                   Foreground="White"
                                   TextWrapping="Wrap"/>

                    </ScrollViewer>

                    <TextBlock x:Name="txtContador"
                               Text="1 / 10"
                               Margin="0,20"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{Binding ElementName=bordaPersonagem, Path=BorderBrush}"/>

                    <Grid Margin="0,15,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnAnterior"
            Width="260"
            Height="110"
            HorizontalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Click="BtnAnterior_Click" 
            Margin="0,-60,0,60">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image x:Name="imgAnterior"
                           Source="/Imagens/BotaoAnterior.png"
                           Stretch="Uniform"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="imgAnterior" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="imgAnterior" Property="Opacity" Value="0.70"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                        </Button>

                        <Button x:Name="btnProximo"
            Grid.Column="1"
            Width="260"
            Height="110"
            HorizontalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Click="BtnProximo_Click" 
            Margin="0,-61,0,61">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image x:Name="imgProximo"
                           Source="/Imagens/BotaoProximo.png"
                           Stretch="Uniform"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="imgProximo" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="imgProximo" Property="Opacity" Value="0.70"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                        </Button>

                    </Grid>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>